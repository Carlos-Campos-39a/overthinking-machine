# ── Modo hospedado (BYOK) ────────────────────────────────────────────
# 1 = a instância NÃO usa chaves próprias; cada visitante envia a dele
#     por header. Use isto em produção — impede que terceiros gastem
#     a sua cota e que a chave de um visitante vaze para outro.
OTM_HOSTED=1

# Domínios do frontend autorizados a chamar esta API (separados por vírgula).
# Deixe "*" apenas em desenvolvimento local.
OTM_ALLOWED_ORIGINS=https://seu-projeto.vercel.app

# ── Chaves (APENAS para uso local, com OTM_HOSTED=0) ─────────────────
# NUNCA defina estas variáveis numa instância pública: elas seriam usadas
# por qualquer visitante, na sua conta.
#
# São os mesmos 9 provedores que o modal do site aceita. Veja onde obter cada
# chave em: https://overthinking-machine-chi.vercel.app/baixar/PROVEDORES.md
# GOOGLE_API_KEY=        # Gemini e Gemma
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MOONSHOT_API_KEY=      # Kimi (peso aberto)
# ZAI_API_KEY=           # GLM (peso aberto)
# GROQ_API_KEY=          # Llama/Gemma, inferência rápida
# TOGETHER_API_KEY=      # agregador de peso aberto
# OPENROUTER_API_KEY=    # agregador multi-provedor
# DEEPINFRA_API_KEY=     # agregador de peso aberto

# ── Biblioteca compartilhada e administração ─────────────────────────
# Diretório do banco da biblioteca. No Railway precisa ser um VOLUME
# montado — sem isso o acervo é recriado a cada deploy.
# OTM_DATA_DIR=/data
# Token para apagar topologia publicada por terceiro (header X-OTM-Admin).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# OTM_ADMIN_TOKEN=
# Sal do hash de IP usado no limite de publicações (nunca guardamos o IP).
# OTM_IP_SALT=
# Limites de publicação por IP.
# OTM_PUB_POR_HORA=5
# OTM_PUB_POR_DIA=20

# ── MCP e verificação ────────────────────────────────────────────────
# OTM_API_URL=http://localhost:8000     # a API que o MCP consulta
# OTM_MCP_HOST=127.0.0.1
# OTM_MCP_PORT=8765
# OTM_MCP_TIMEOUT=1800
# Usados por validate_platform.py --producao:
# OTM_PROD_API=https://overthinking-machine-production.up.railway.app
# OTM_PROD_SITE=https://overthinking-machine-chi.vercel.app

# ── Modelos open-weight locais (opcional) ────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434/v1
# VLLM_BASE_URL=http://localhost:8000/v1
# Alguns servidores locais exigem um token qualquer; o padrão é "not-needed".
# LOCAL_LLM_API_KEY=
